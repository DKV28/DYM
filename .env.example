# Sao chép file này thành .env và điền API key của bạn
# Lấy key MIỄN PHÍ tại: https://aistudio.google.com/apikey (không cần thẻ tín dụng)
GEMINI_API_KEY=AIza...xxxxxxxxxxxxxxxxxxxxxxxx

# Model dùng để đọc tài liệu (mặc định gemini-3.5-flash-lite — có bậc free)
# Có thể đổi sang model Gemini khác mà tài khoản của bạn được phép dùng.
GEMINI_MODEL=gemini-3.5-flash-lite

# (Tuỳ chọn) Số trang PDF tối đa xử lý cho mỗi file
MAX_PDF_PAGES=10

# ---- Supabase (lưu lịch sử hồ sơ) ----
# Lấy tại: Supabase Dashboard → Project Settings → API
# Bỏ trống nếu không dùng database (app vẫn chạy, chỉ không lưu lịch sử)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# QUAN TRỌNG: dùng service_role key (chỉ để phía server, TUYỆT ĐỐI không đưa lên frontend)
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role_key...
# (Tuỳ chọn) tên bảng, mặc định ho_so_nhan_vien
SUPABASE_TABLE=ho_so_nhan_vien
