# Sao chép file này thành .env và điền API key của bạn
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model vision dùng để đọc tài liệu (mặc định gpt-4o)
OPENAI_MODEL=gpt-4o

# (Tuỳ chọn) Số trang PDF tối đa xử lý cho mỗi file
MAX_PDF_PAGES=10
